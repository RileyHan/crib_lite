[resource]
script = ExtResource("1_cfg")
stage_count = 10
starting_currency = 0
regular_options = 2
min_encounters_per_stage = 2
regular_templates = Array[ExtResource("2_data")]([ExtResource("3_casual"), ExtResource("4_regular")])
boss_templates = Array[ExtResource("2_data")]([ExtResource("5_dealer"), ExtResource("6_shark")])
profiles = Array[ExtResource("7_prof")]([ExtResource("8_easy"), ExtResource("9_normal"), ExtResource("10_hard")])
target_growth = 3
reward_growth = 1
retry_cost_growth = 1
perk_pool = Array[ExtResource("11_perkdata")]([ExtResource("12_fifteen_fever"), ExtResource("13_fives_alive"), ExtResource("14_pair_pressure"), ExtResource("15_head_start"), ExtResource("16_dealers_edge"), ExtResource("17_tip_jar"), ExtResource("18_runners_high"), ExtResource("19_nobs_knack"), ExtResource("20_low_bar"), ExtResource("21_extra_hand"), ExtResource("22_haggler"), ExtResource("23_lucky_hand"), ExtResource("24_hot_streak"), ExtResource("26_momentum"), ExtResource("27_run_rhythm")])
starter_choices = 3
shop_config = ExtResource("25_shop")
chips_mult = true
score_scale = 6
starting_pegs = Array[PegData]([ExtResource("28_fifteen_peg"), ExtResource("29_run_peg"), ExtResource("30_pair_peg")])
peg_pool = Array[PegData]([ExtResource("pp_crib_peg"), ExtResource("pp_double_run_peg"), ExtResource("pp_fifteen_peg"), ExtResource("pp_flush_peg"), ExtResource("pp_gold_fifteen_peg"), ExtResource("pp_lucky_pair_peg"), ExtResource("pp_nobs_peg"), ExtResource("pp_pair_peg"), ExtResource("pp_run_peg"), ExtResource("pp_the_dealer_peg"), ExtResource("pp_the_runner_peg"), ExtResource("pp_the_skunk_peg")])
relic_pool = Array[RelicData]([ExtResource("rp_accountant_relic"), ExtResource("rp_cutthroat_relic"), ExtResource("rp_dealer_relic"), ExtResource("rp_gambler_relic"), ExtResource("rp_pairadox_relic"), ExtResource("rp_runner_relic")])
