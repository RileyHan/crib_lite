[resource]
script = ExtResource("1_cfg")
stage_count = 10
starting_currency = 0
regular_options = 2
min_encounters_per_stage = 2
regular_templates = Array[ExtResource("2_data")]([ExtResource("3_casual"), ExtResource("4_regular")])
boss_templates = Array[ExtResource("2_data")]([ExtResource("5_dealer"), ExtResource("6_shark")])
profiles = Array[ExtResource("7_prof")]([ExtResource("8_easy"), ExtResource("9_normal"), ExtResource("10_hard")])
target_growth = 3
reward_growth = 1
retry_cost_growth = 1
perk_pool = Array[ExtResource("11_perkdata")]([ExtResource("12_fifteen_fever"), ExtResource("13_fives_alive"), ExtResource("14_pair_pressure"), ExtResource("15_head_start"), ExtResource("16_dealers_edge"), ExtResource("17_tip_jar"), ExtResource("18_runners_high"), ExtResource("19_nobs_knack"), ExtResource("20_low_bar"), ExtResource("21_extra_hand"), ExtResource("22_haggler"), ExtResource("23_lucky_hand"), ExtResource("24_hot_streak")])
starter_choices = 3
